## Copy this file to .env.local and fill with your Supabase values

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older naming still works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side role key for admin/server operations
SUPABASE_SERVICE_ROLE_KEY=
# Legacy alias still supported
# SUPABASE_SECRET_KEY=

# Public app URL used for redirects/callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Workspace hot-loading rollout: off (default), shadow, or on.
WORKSPACE_HOT_LOADING_V2=off
# Enable only for the staging performance runner.
PERF_TEST_MODE=0
